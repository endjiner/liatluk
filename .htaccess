# Deny direct access to sensitive folders and files
<FilesMatch "(\.env.*|\.sql|\.lock|composer\.(json|lock)|package(-lock)?\.json|phpunit\.dist\.xml|\.htaccess|README.*|LICENSE|preload\.php|spark|builds)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

Options -Indexes -MultiViews

# Rewrite ke folder public/ untuk shared hosting (InfinityFree / cPanel)
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Blokir akses ke folder sistem internal
    RewriteRule ^(app|writable|vendor|tests|\.git) - [F,L]

    # Jangan rewrite jika request sudah mengarah ke /public/
    RewriteCond %{REQUEST_URI} !^/public/

    # Rewrite seluruh request ke public/
    RewriteRule ^(.*)$ public/$1 [L,QSA]
</IfModule>
