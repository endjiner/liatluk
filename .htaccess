# Deny direct access to sensitive folders and files
# <Directory> is not allowed in .htaccess - using FilesMatch instead

<FilesMatch "(\.env.*|\.sql|\.lock|composer\.(json|lock)|package(-lock)?\.json|phpunit\.dist\.xml|\.htaccess|README.*|LICENSE|debug\.php|preload\.php|builds)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

Options -Indexes -MultiViews
